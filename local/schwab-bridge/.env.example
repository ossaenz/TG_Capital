# Path to the read-only source SQLite DB. Default assumes this bridge lives
# in local/schwab-bridge/ next to local/data/trades.db.
# Porting to another project (e.g. Leo)? This is the one line that changes.
SOURCE_DB_PATH=../data/trades.db

# Path to this bridge's own read-write query vault DB.
VAULT_DB_PATH=./vault.db

# Bind address/port for `python main.py`. Not 8080 — the local Node
# companion server already uses that for its Schwab OAuth HTTPS listener.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
